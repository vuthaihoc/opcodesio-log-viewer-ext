<?xml version="1.0" encoding="UTF-8"?>
<!--
    Toàn bộ test của package: `composer install && composer test`.
    - Unit: phần PHP thuần (bộ đọc log của agent), không cần Laravel — chạy được cả bằng
      phpunit của app đang dùng package (chọn testsuite Unit).
    - Feature: phần cần Laravel (HTTP, lệnh, logger, config) trên orchestra/testbench — cần
      vendor của chính package.
-->
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true" failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
